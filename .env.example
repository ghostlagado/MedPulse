# ============================================================
# MedPulse — exemplo de configuração
# Copie para .env e preencha. NUNCA versione o .env real.
# ============================================================

# --- Aplicação ------------------------------------------------
DEBUG=False
HOST=127.0.0.1
PORT=5000

# Fuso horário da operação hospitalar, no formato IANA. É a única referência do
# relógio do painel: a hora exibida vem do servidor, nunca da máquina que abre a TV.
TIMEZONE=America/Sao_Paulo

# Chave de sessão do Flask. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET=troque-esta-chave

# --- Banco de dados -------------------------------------------
# PostgreSQL (uso normal da aplicação)
DB_URI=postgresql+psycopg2://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO
# Alternativa para experimentar sem PostgreSQL:
# DB_URI=sqlite:///medpulse.db

# --- Ingestão via webhook -------------------------------------
# Token exigido no header X-Webhook-Token do POST /api/webhook/atendimentos.
# Deixe vazio apenas em desenvolvimento: sem token o endpoint fica aberto.
WEBHOOK_TOKEN=

# --- Showcase (dados sintéticos do ambiente de demonstração) ---
# Habilita o gerador. Ele só escreve em hospitais com demo=True.
SHOWCASE_ENABLED=false
# Intervalo base entre ciclos (ms).
SHOWCASE_INTERVALO_MS=2600
# Acelera as taxas de chegada/progressão (não altera o relógio real).
# 1 = ritmo assistencial realista; 6 = ritmo de demonstração; >10 = muito rápido.
SHOWCASE_VELOCIDADE=6
# Teto de atendimentos abertos simultâneos no hospital demo.
SHOWCASE_MAX_ABERTOS=140
# Restringe a ids explícitos (vazio = todos os hospitais com demo=True).
SHOWCASE_HOSPITAIS=
